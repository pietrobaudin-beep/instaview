// InstaView — Prisma schema
// Detect who started following any Instagram profile via snapshot diffing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / accounts
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  // Faro de Cão — semanal. Acrescentado em 20/09; só acrescenta valor ao enum,
  // não mexe em nenhuma linha existente.
  WEEK
  PRO
  AGENCY
}

model User {
  id            String   @id @default(cuid())
  // Sign-in is by one-time code, sent to the email OR the WhatsApp number, so
  // either can be missing — but every account has at least one of them.
  email         String?  @unique
  // E.164, e.g. "+5511999999999".
  phone         String?  @unique
  // Optional: people pick a name after signing up, or never.
  name          String?
  // Legacy password logins (before one-time codes). No longer used to sign in.
  passwordHash  String?
  plan          Plan     @default(FREE)
  // Stripe billing (scaffold — see lib/plans.ts)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trackedProfiles TrackedProfile[]
  memberships     Membership[]
  unlocks         ProfileUnlock[]

  @@map("users")
}

// Agencies / teams: many users can access many profiles (AGENCY plan).
model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())

  members         Membership[]
  trackedProfiles TrackedProfile[]

  @@map("organizations")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Tracked profiles + collection pipeline
// ---------------------------------------------------------------------------

enum MonitoringStatus {
  ACTIVE
  PAUSED
  ERROR
}

model TrackedProfile {
  id       String @id @default(cuid())
  // The Instagram handle being monitored (normalized, no leading @).
  username String

  // Cached profile metadata (refreshed on each collection).
  displayName    String?
  avatarUrl      String?
  bio            String?
  isPrivate      Boolean @default(false)
  isVerified     Boolean @default(false)
  followersCount Int     @default(0)
  followingCount Int     @default(0)
  postsCount     Int     @default(0)

  status            MonitoringStatus @default(ACTIVE)
  monitoringStartedAt DateTime       @default(now())
  lastCollectedAt   DateTime?
  lastError         String?

  // When true, each collection fetches the ENTIRE follower list (not just the
  // recent head), which enables reliable UNFOLLOW detection. Costs more
  // provider requests, so it's opt-in per profile.
  captureFull       Boolean @default(false)

  // Per-profile alert switches shown on the tracking screen
  // ({ notifications, newFollowing, unfollowed, postInteractions, stories }).
  trackingPrefs     Json?

  // Ownership: a profile belongs to a user, optionally scoped to an org.
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  snapshots FollowerSnapshot[]
  followers Follower[]
  changes   FollowerChange[]
  job       MonitoringJob?
  alertRules AlertRule[]
  events     ProfileEvent[]

  // A given user cannot track the same handle twice.
  @@unique([userId, username])
  @@index([status])
  @@index([username])
  @@map("tracked_profiles")
}

enum SnapshotStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

// One collection of (the head of) the follower list at a moment in time.
model FollowerSnapshot {
  id        String         @id @default(cuid())
  profileId String
  status    SnapshotStatus @default(PENDING)
  // Which list this snapshot is of: "followers" or "following".
  kind      String         @default("followers")
  // For post-level snapshots (likes/comments): which media this refers to.
  mediaId   String?

  // Whether the provider returned the FULL list or only the recent head.
  // "head" mode reliably detects FOLLOWs but not UNFOLLOWs of old accounts.
  mode        String  @default("head") // "head" | "full"
  capturedCount Int   @default(0)      // followers seen in this snapshot
  followersCount Int  @default(0)      // profile-reported total at capture time
  followingCount Int  @default(0)      // profile-reported "seguindo" total at capture time

  // Profile attributes at capture time, so we can report "changed the bio" /
  // "the account went private" by comparing consecutive snapshots.
  bio       String?
  isPrivate Boolean @default(false)

  // Diff results, denormalized for fast reads.
  newFollowerCount  Int @default(0)
  lostFollowerCount Int @default(0)

  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  profile   TrackedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  followers Follower[]
  changes   FollowerChange[]

  @@index([profileId, startedAt])
  @@map("follower_snapshots")
}

// A follower observed in a specific snapshot.
model Follower {
  id         String @id @default(cuid())
  profileId  String
  snapshotId String

  username    String
  displayName String?
  avatarUrl   String?
  isVerified  Boolean @default(false)
  position    Int     @default(0) // index within the returned list (0 = most recent)

  observedAt DateTime @default(now())

  profile  TrackedProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  snapshot FollowerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([profileId, username])
  @@index([snapshotId])
  @@map("followers")
}

enum ChangeType {
  FOLLOW
  UNFOLLOW
}

// The headline event: a follower started (or stopped) following the profile.
model FollowerChange {
  id              String     @id @default(cuid())
  profileId       String
  snapshotId      String
  followerUsername String
  type            ChangeType
  // "followers" = who follows the profile; "following" = who the profile follows.
  kind            String     @default("followers")
  mediaId         String?

  // Follower metadata captured at detection time.
  displayName String?
  avatarUrl   String?
  isVerified  Boolean @default(false)

  detectedAt DateTime @default(now())

  profile  TrackedProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  snapshot FollowerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  // Fast queries for the dashboard: "new followers in last 24h/7d/30d".
  @@index([profileId, type, detectedAt])
  @@index([profileId, kind, detectedAt])
  @@index([profileId, detectedAt])
  @@index([snapshotId])
  @@map("follower_changes")
}

// ---------------------------------------------------------------------------
// One-off purchases
// ---------------------------------------------------------------------------

// "Uso único": a single paid unlock of ONE profile's full analysis, without a
// subscription. It never includes Pro features such as putting the profile
// "no Faro" (ongoing tracking).
model ProfileUnlock {
  id       String @id @default(cuid())
  userId   String
  username String
  // The Stripe Checkout session that paid for it; null for demo-mode unlocks.
  stripeSessionId String? @unique

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, username])
  @@map("profile_unlocks")
}

// ---------------------------------------------------------------------------
// Sign-in codes
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Raio-X
// ---------------------------------------------------------------------------

// One provider answer per (profile, section) — stories, reels, tags… — shared by
// everyone who opens that profile, so the same data is never paid for twice
// within its freshness window (a few hours for stories, a day for the rest).
model SectionCache {
  username  String
  section   String
  data      Json
  fetchedAt DateTime @default(now())

  @@id([username, section])
  @@map("section_cache")
}

// Something the Faro found on a profile it watches: a new post, reel, story,
// tag or highlight. Items that already existed when the profile was pinned are
// stored as the baseline and never shown as news — the Faro only reports what
// is new from then on.
model ProfileEvent {
  id         String   @id @default(cuid())
  profileId  String
  kind       String // "post" | "reel" | "story" | "tagged" | "highlight"
  refId      String
  data       Json
  baseline   Boolean  @default(false)
  detectedAt DateTime @default(now())

  profile TrackedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, refId])
  @@index([profileId, baseline, detectedAt])
  @@map("profile_events")
}

// A failed attempt at a protected door (for now, the admin login), kept for a
// day so repeated guessing can be slowed down. `key` is a keyed hash of where
// the attempt came from — never the raw IP.
model AuthFailure {
  id        String   @id @default(cuid())
  scope     String // "admin"
  key       String
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
  @@index([scope, key, createdAt])
  @@map("auth_failures")
}

// A one-time sign-in code sent by email or WhatsApp. Only a keyed hash of the
// code is stored, never the code itself. A code dies when it is used, when it
// expires, or after too many wrong guesses.
model LoginCode {
  id       String @id @default(cuid())
  channel  String // "email" | "whatsapp"
  // Normalized destination: lowercased email, or E.164 phone.
  target   String
  codeHash String
  attempts Int    @default(0)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, createdAt])
  @@index([channel, createdAt])
  @@map("login_codes")
}

// ---------------------------------------------------------------------------
// Free-plan usage
// ---------------------------------------------------------------------------

// One row per profile a free identity has analysed. The free plan allows a
// single profile, so this is what the paywall counts. Re-opening the SAME
// profile is always allowed — it costs nothing extra and would feel broken.
model AnalysisUsage {
  id String @id @default(cuid())
  // "u:<userId>" when signed in, "v:<visitorId>" for an anonymous visitor.
  key      String
  username String

  createdAt DateTime @default(now())

  @@unique([key, username])
  @@index([key])
  @@map("analysis_usage")
}

// ---------------------------------------------------------------------------
// Monitoring jobs (cron scheduling per profile)
// ---------------------------------------------------------------------------

model MonitoringJob {
  id        String @id @default(cuid())
  profileId String @unique

  enabled          Boolean @default(true)
  intervalMinutes  Int     @default(120)
  nextRunAt        DateTime @default(now())
  lastRunAt        DateTime?
  lastRunStatus    String?  // "success" | "partial" | "failed"
  consecutiveFailures Int   @default(0)
  runCount         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile TrackedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // The cron endpoint claims due jobs with: WHERE enabled AND nextRunAt <= now()
  @@index([enabled, nextRunAt])
  @@map("monitoring_jobs")
}

// ---------------------------------------------------------------------------
// Alerts (architecture prepared; only console/log channel active in MVP)
// ---------------------------------------------------------------------------

enum AlertChannel {
  EMAIL
  WEBHOOK
  TELEGRAM
  DISCORD
}

enum AlertTrigger {
  NEW_FOLLOWER          // fire per detected new follower
  FOLLOWER_MILESTONE    // fire when gained N followers in a window
}

model AlertRule {
  id        String       @id @default(cuid())
  profileId String
  channel   AlertChannel
  trigger   AlertTrigger @default(NEW_FOLLOWER)
  enabled   Boolean      @default(true)

  // Channel target: email address, webhook URL, chat id, etc.
  target       String
  // For FOLLOWER_MILESTONE: threshold + window in hours.
  threshold    Int?
  windowHours  Int?

  createdAt DateTime @default(now())

  profile        TrackedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deliveries     AlertDelivery[]

  @@index([profileId, enabled])
  @@map("alert_rules")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model AlertDelivery {
  id        String         @id @default(cuid())
  ruleId    String
  status    DeliveryStatus @default(PENDING)
  payload   Json
  error     String?
  createdAt DateTime       @default(now())
  sentAt    DateTime?

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, status])
  @@map("alert_deliveries")
}
