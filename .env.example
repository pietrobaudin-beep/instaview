# ---------------------------------------------------------------------------
# InstaView environment variables
# Copy this file to `.env` and fill in the values. Everything below has a
# sensible default for LOCAL development except DATABASE_URL.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local Postgres via the provided docker-compose.yml:
DATABASE_URL="postgresql://instaview:instaview@localhost:5432/instaview?schema=public"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Any random string. Used to sign the dev session cookie and protect the cron endpoint.
APP_SECRET="dev-secret-change-me"
LOG_LEVEL="info" # debug | info | warn | error

# --- Instagram data provider ----------------------------------------------
# Which InstagramDataProvider adapter to use: "mock" | "hikerapi"
# "mock" runs 100% locally with no external account and no cost.
INSTAGRAM_PROVIDER="mock"

# How many "pages" (head of the follower list) each collection pulls.
# The realistic technique: fetch only the most-recent followers each cycle.
PROVIDER_FOLLOWER_PAGES="5"
PROVIDER_PAGE_SIZE="50"

# --- HikerAPI (only needed when INSTAGRAM_PROVIDER=hikerapi) ---------------
# Sign up at https://hikerapi.com — you accept their terms and Instagram ToS risk.
HIKERAPI_KEY=""
HIKERAPI_BASE_URL="https://api.hikerapi.com"

# --- Cron / job runner -----------------------------------------------------
# Protects POST /api/cron. Vercel Cron sends this as the Authorization header.
CRON_SECRET="dev-cron-secret-change-me"
# Default minimum minutes between collections per profile (plan can override).
DEFAULT_COLLECTION_INTERVAL_MINUTES="120"

# --- Auth (dev mode) -------------------------------------------------------
# "dev" = cookie-based passwordless login for local development.
# "supabase" = use Supabase Auth (see README for wiring).
AUTH_MODE="dev"

# --- Supabase (only needed when AUTH_MODE=supabase) ------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (billing scaffold — optional for MVP) --------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=""
